# ---- Required ----
# Get a free key at https://console.groq.com/
GROQ_API_KEY=your_GROQ_key

# ---- AI models ----
# Chat model used for notes/quiz/flashcards generation.
# Current Groq production models: openai/gpt-oss-20b, openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b
# Whisper model for speech-to-text (hosted by Groq)
WHISPER_MODEL=whisper-large-v3

# ---- Limits ----
# Max upload size in bytes (50 MB default)
MAX_CONTENT_LENGTH=52428800
# Session lifetime in seconds before it expires and its uploaded file is deleted
SESSION_TTL_SECONDS=21600
# Rate limits per IP per hour (0 disables)
RATE_LIMIT_TRANSCRIBE=5
RATE_LIMIT_GENERATE=20

# ---- Tuning ----
# Read timeout for Groq calls in seconds
GROQ_TIMEOUT=90
WHISPER_TIMEOUT=120
# Max transcript characters sent to the LLM per request
TRANSCRIPT_MAX_CHARS=40000

# ---- Security ----
# Comma-separated list of allowed CORS origins. Use * for development only.
CORS_ORIGINS=*